    {
      "parameters": {
        "html": "<!doctype html>\n<style>\n.btn-pay {\n  display: inline-block;\n  margin-top: 24px;\n  padding: 12px 24px;\n  background: #16a34a;\n  color: #ffffff;\n  text-decoration: none;\n  border-radius: 6px;\n  font-weight: bold;\n  font-size: 14px;\n}\n.btn-pay:hover {\n  background: #15803d;\n}\n.btn-wrapper {\n  text-align: left;\n}\n</style>\n<html>\n<head>\n  <meta charset=\"utf-8\">\n  <style>\n    body { font-family: Arial, sans-serif; font-size: 12px; }\n    .container { width: 720px; margin: auto; }\n    h1 { margin-bottom: 4px; }\n    table { width: 100%; border-collapse: collapse; margin-top: 16px; }\n    th, td { border-bottom: 1px solid #ddd; padding: 8px; }\n    th { background: #f5f5f5; }\n    .right { text-align: right; }\n    .total { font-weight: bold; font-size: 14px; }\n  </style>\n</head>\n\n<body>\n  <div class=\"container\">\n    <h1>Invoice</h1>\n\n    <p>\n      <strong>Invoice #:</strong> {{ $('prepare data').item.json.invoice_number }}<br>\n      <strong>Date:</strong> {{ $('Create Invoice').item.json.data.expiredAt.toDateTime('ms').minus(1, 'days').toLocaleString() }}\n    </p>\n\n    <table>\n      <thead>\n        <tr>\n          <th>#</th>\n          <th>Item</th>\n          <th class=\"right\">Price</th>\n          <th class=\"right\">Qty</th>\n          <th class=\"right\">Total</th>\n        </tr>\n      </thead>\n      <tbody>\n        {{ $('prepare data').item.json.rowsHtml }}\n      </tbody>\n      <tfoot>\n        <tr>\n          <td colspan=\"4\" class=\"right\">Subtotal</td>\n          <td class=\"right\">Rp {{ $('prepare data').item.json.subtotal.format('id-ID') }}</td>\n        </tr>\n        <tr>\n          <td colspan=\"4\" class=\"right total\">Total</td>\n          <td class=\"right total\">Rp {{ $('prepare data').item.json.total_amount.format('id-ID') }}</td>\n        </tr>\n      </tfoot>\n    </table>\n    <div class=\"btn-wrapper\">\n  <a\n    class=\"btn-pay\"\n    href=\"{{ $('Create Invoice').item.json.data.link }}\"\n    target=\"_blank\"\n  >\n    💳 Bayar\n  </a>\n</div>\n  </div>\n</body>\n</html>"
